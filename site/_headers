# Security and cache headers for Cloudflare Pages (garland.csilab.am)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; upgrade-insecure-requests

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/site.js
  Cache-Control: public, max-age=0, must-revalidate

/lang.js
  Cache-Control: public, max-age=0, must-revalidate

/downloads.js
  Cache-Control: public, max-age=0, must-revalidate

/downloads/*
  Cache-Control: public, max-age=60, must-revalidate
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
